<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/>
    </startup>
    <runtime>
        <!-- Nokta bulutu dizileri 2 GB'tan büyük olabilsin (64 bit). -->
        <gcAllowVeryLargeObjects enabled="true"/>
    </runtime>
</configuration>
